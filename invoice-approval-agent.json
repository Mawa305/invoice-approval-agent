        "text": "=Vendor: {{ $json.body.vendor }}\nInvoice: {{ $json.body.invoice_number }}\nAmount: {{ $json.body.amount }} {{ $json.body.currency }}\nPO: {{ $json.body.po_number }}\nDescription: {{ $json.body.description }}",
        "options": {
          "systemMessage": "You are an invoice policy checker for a company in Lahore.\nYou receive an invoice. Decide if it can be auto-approved or needs human approval.\n\nRules:\n1. Auto-approve only if amount is 50000 or less AND currency is PKR AND po_number is present.\n2. Otherwise, the decision is needs_human.\n3. Use only the invoice data given. Do not invent limits, vendors, or PO details.\n\nReturn ONLY valid JSON, with no extra text or markdown:\n{\n  \"decision\": \"auto_approve\" or \"needs_human\",\n  \"reason\": \"one short sentence explaining the decision\"\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        448,
        -64
      ],
      "id": "a84373e8-846e-4e3d-b0e0-61f54c92c3fc",
