    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '';\n\nlet data;\ntry {\n  data = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (err) {\n  data = {\n    decision: 'needs_human',\n    reason: 'Policy output could not be parsed. Send to human review.'\n  };\n}\n\nreturn [{\n  json: {\n    decision: data.decision === 'auto_approve' ? 'auto_approve' : 'needs_human',\n    reason: data.reason || 'no reason given'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
